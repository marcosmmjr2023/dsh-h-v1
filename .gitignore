# ── Dependencias (junction para a arvore global; nunca versionar) ──────────
source/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Segredos / credenciais (NAO versionar) ────────────────────────────────
.credentials.yaml
.credentials.yaml.bak
.credentials.yaml.bak-*
dsh_dot_dsh_config/.credentials.yaml
dsh_dot_dsh_config/.credentials.yaml.bak*
dsh_dot_dsh_config/.anonymous-user-id

# ── Estado de runtime / sessoes / logs / temporarios ───────────────────────
dsh_dot_dsh_config/sessions/
dsh_dot_dsh_config/storages/
dsh_dot_dsh_config/web.log
dsh_dot_dsh_config/*.log
dsh_dot_dsh_config/settings.yaml.bak*
dsh_dot_dsh_config/profiles/*/node_modules/
dsh_dot_dsh_config/profiles/*/#*
dsh_dot_dsh_config/profiles/tui/state.json
*.log
*.tmp

# ── Ambiente local / scratch de editores ───────────────────────────────────
.env
.env.local
.env.*.local
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
